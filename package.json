{
  "name": "starwars-data-explorer",
  "version": "1.1.0",
  "private": true,
  "description": "A procedural, data-driven Star Wars archive built with Next.js and SWAPI.",
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm build",
    "clean": "node -e \"require('node:fs').rmSync('.next', { recursive: true, force: true })\""
  },
  "keywords": [
    "star-wars",
    "nextjs",
    "react",
    "swapi",
    "data-visualization"
  ],
  "author": "Tero Leinonen",
  "license": "MIT",
  "dependencies": {
    "framer-motion": "^12.42.2",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.10",
    "fast-check": "^4.9.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
