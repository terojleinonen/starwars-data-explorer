{
  "name": "starwars-universe",
  "version": "2.0.0",
  "private": true,
  "description": "An independent, cinematic introduction to a source-led Star Wars universe.",
  "license": "MIT",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "pnpm data:check && pnpm lint && pnpm typecheck && pnpm build",
    "data:build": "node scripts/build-database.mjs",
    "data:check": "node scripts/check-archive.mjs"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "typescript": "6.0.3"
  }
}
